# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=multi_agent_chatroom
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Groq LLM Configuration
GROQ_API_KEY=your-groq-api-key-here

# Vector DB Configuration (Optional)
VECTOR_DB_TYPE=mongodb  # Options: mongodb, pinecone, weaviate
# PINECONE_API_KEY=your-key-if-using-pinecone
# WEAVIATE_URL=your-url-if-using-weaviate
